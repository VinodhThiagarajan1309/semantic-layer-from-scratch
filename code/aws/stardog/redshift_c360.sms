# Virtual graph: redshift_c360 — analytics side. purchasedBy mints the SAME customer IRI as Aurora:
# that template agreement is the cross-warehouse join.
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix : <tag:stardog:api:ecomm:>

MAPPING <urn:c360:redshift:purchase>
FROM SQL {
  SELECT id, pid, "date" AS pdate, "time" AS ptime, quantity, price, cid, card, reward_account,
         CAST("date" AS varchar) || ' ' || "time" || ' - $' || CAST(price AS varchar) AS label
  FROM c360.purchase
}
TO {
  ?iri a :Order ; rdfs:label ?label ;
    :purchasePrice ?p ; :quantity ?q ; :purchaseTime ?ptime ; :purchaseDate ?dt ;
    :purchasedBy ?cust_iri ; :itemPurchased ?product ; :cardUsed ?cc ; :rewardsAccountUsed ?rewardsIri .
}
WHERE {
  BIND(TEMPLATE("urn:stardog:demos:c360:purchase:us:pos{id}") AS ?iri)
  BIND(TEMPLATE("urn:stardog:demos:c360:customer:{cid}") AS ?cust_iri)
  BIND(TEMPLATE("urn:stardog:demos:c360:product:{pid}") AS ?product)
  BIND(TEMPLATE("urn:stardog:demos:c360:cards:{card}") AS ?cc)
  BIND(TEMPLATE("urn:stardog:demos:c360:rewards:{reward_account}") AS ?rewardsIri)
  BIND(xsd:decimal(?price) AS ?p)
  BIND(xsd:integer(?quantity) AS ?q)
  BIND(xsd:date(?pdate) AS ?dt)
}
;
MAPPING <urn:c360:redshift:product>
FROM SQL { SELECT id, name, brand, price, dept, description, '$' || CAST(price AS varchar) AS price_label FROM c360.product }
TO {
  ?iri a :Product ; :inCategory ?cat_iri ; :description ?description ; :msrp ?up ;
    :vendor ?vendor_iri ; :name ?name ; rdfs:label ?name .
  ?up a :UnitPrice ; rdfs:label ?price_label ; :hasCurrency "USD" ; :hasPrice ?pf .
}
WHERE {
  BIND(TEMPLATE("urn:stardog:demos:c360:product:{id}") AS ?iri)
  BIND(TEMPLATE("urn:stardog:demos:c360:category:{dept}") AS ?cat_iri)
  BIND(TEMPLATE("urn:stardog:demos:c360:vendor:{brand}") AS ?vendor_iri)
  BIND(TEMPLATE("urn:stardog:demos:c360:unitprice:{id}") AS ?up)
  BIND(xsd:float(?price) AS ?pf)
}
;
MAPPING <urn:c360:redshift:category>
FROM SQL { SELECT id, dept_name FROM c360.category }
TO { ?iri a :Category ; :name ?dept_name ; rdfs:label ?dept_name . }
WHERE { BIND(TEMPLATE("urn:stardog:demos:c360:category:{id}") AS ?iri) }
;
MAPPING <urn:c360:redshift:vendor>
FROM SQL { SELECT id, vendor_name, industry, homepage FROM c360.vendor }
TO {
  ?iri a :Vendor ; :industry ?ind ; :homepage ?homepage ; :name ?vendor_name ; rdfs:label ?vendor_name .
  ?ind a :Industry ; :name ?industry ; rdfs:label ?industry .
}
WHERE {
  BIND(TEMPLATE("urn:stardog:demos:c360:vendor:{vendor_name}") AS ?iri)
  BIND(TEMPLATE("urn:stardog:demos:c360:industry:{industry}") AS ?ind)
}
